# Copy this file to .env (in this same scripts/ folder) and fill in your own
# values. See README.md, "Get Zoho OAuth credentials", for how to obtain them.
# Never commit the real .env file; it holds live credentials.

# From your Zoho API console self-client, under the "Client Secret" tab.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# Generated once via the self-client's grant/refresh-token flow. Long-lived;
# does not expire unless revoked.
ZOHO_REFRESH_TOKEN=

# Optional. The Zoho datacenter your org's account lives in: in, com, eu, au,
# or jp. Defaults to "in" if omitted. Must match the DC or token exchange
# fails with an invalid_client error.
ZOHO_DC=in
